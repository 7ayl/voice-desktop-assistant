# Voice Recognition API
ASR_SERVICE=paddlespeech  # or baidu, iflytek
ASR_API_KEY=your_api_key

# Text-to-Speech API
TTS_SERVICE=edge-tts  # or baidu, iflytek
TTS_API_KEY=your_api_key

# Application Settings
FLASK_ENV=development
FLASK_DEBUG=True
LOG_LEVEL=INFO

# File operations
DEFAULT_DRIVES=C:,D:,E:,F:
